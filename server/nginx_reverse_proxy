# Default server configuration
#
server {
    # Accept requests only for this hostname.
    server_name ink-app-api.duckdns.org www.ink-app-api.duckdns.org;

    # These defaults are not used because all paths are proxied below.
        root /var/www/html;
        index index.html index.htm index.nginx-debian.html;

        location / {
                # Send every API path to the local application server.
                proxy_pass http://localhost:8000;
                proxy_http_version 1.1;

                # Preserve the original client and request details for the app.
                proxy_set_header X-Real-IP $remote_addr;
                proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                proxy_set_header Host $http_host;
                proxy_set_header X-Forwarded-Proto $scheme;
                proxy_set_header X-Forwarded-Host $host;

                # Support upgraded connections such as WebSockets.
                proxy_set_header Upgrade $http_upgrade;
                proxy_set_header Connection 'upgrade';

                # Identify this request as having passed through Nginx.
                proxy_set_header X-NginX-Proxy true;

                # Keep redirect URLs generated by the backend unchanged.
                proxy_redirect off;
        }

    # Certbot-managed TLS certificate and recommended HTTPS settings.
    listen 443 ssl; # managed by Certbot
    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/ink-app-api.duckdns.org/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/ink-app-api.duckdns.org/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
# HTTP requests for the API domain are redirected to the HTTPS URL.
server {
    if ($host = www.ink-app-api.duckdns.org) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = ink-app-api.duckdns.org) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


        listen 80 default_server;
        listen [::]:80 default_server;

    server_name ink-app-api.duckdns.org www.ink-app-api.duckdns.org;
    return 404; # managed by Certbot
}


